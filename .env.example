# Copy to .env (or export in your shell). Everything is optional: with no settings Meridian runs fully offline.
MERIDIAN_HOST=127.0.0.1
MERIDIAN_PORT=8000
# MERIDIAN_DATA_DIR=./data

# Optional LLM answer writer (the verifier still checks every claim; offline composer is the fallback)
# MERIDIAN_LLM_PROVIDER=anthropic        # none | anthropic | openai  (openai = any OpenAI-compatible server: OpenAI, vLLM, Ollama, LM Studio)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:11434/v1
# MERIDIAN_LLM_MODEL=
# MERIDIAN_AGENT_MODE=auto               # auto | policy | llm_tools
